# Run scripts/prepare.ps1 to generate independent local credentials. Never copy real keys into this file.
BA_DATABASE_URL=postgresql+asyncpg://ba_app:REPLACE_LOCAL_PASSWORD@127.0.0.1:15432/ba_dev
BA_PUBLIC_URL=https://localhost:8443
BA_ISSUER_URL=https://localhost:9443
BA_ISSUER_INTERNAL_URL=https://localhost:9443
# Absolute PEM path created by the local Caddy instance; HTTPS verification stays enabled.
BA_CA_FILE=D:/path/to/project/.secrets/ca.crt
BA_ROLE_CLAIM=roles
BA_ROLE_MAPPING={"analyst":"analyst","admin":"admin"}
