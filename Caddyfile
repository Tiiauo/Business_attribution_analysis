{
    admin off
    auto_https disable_redirects
    skip_install_trust
    default_sni {$BA_TLS_SERVER_NAME:192.168.10.22}
}
https://{$BA_TLS_SERVER_NAME:192.168.10.22}:443 {
    tls internal
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin
        Cache-Control no-store
        Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    }
    @backend path /auth/login /auth/callback /auth/me /auth/logout /api/* /health/*
    handle @backend {
        reverse_proxy backend:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
https://{$BA_TLS_SERVER_NAME:192.168.10.22}:9443 {
    tls internal
    reverse_proxy idp:8000
}
